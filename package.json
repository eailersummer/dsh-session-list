{
  "name": "dsh-session-list",
  "version": "0.3.1",
  "description": "DSH web GUI plugin: swaps the built-in right-edge turn navigation rail with a custom one — 默认/自定义 in General settings, a hover list of every question in the session, click-to-jump (including unloaded turns) and active-turn highlight.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
